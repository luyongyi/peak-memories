<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixtures/**/*.cs" />
    <Compile Remove=".build/**/*.cs" />
    <ProjectReference Include="Fixtures/ReleaseVerifierFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopySyntheticFixture" AfterTargets="Build">
    <MSBuild Projects="Fixtures/ReleaseVerifierFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="SyntheticFixturePath" />
    </MSBuild>
    <Copy SourceFiles="@(SyntheticFixturePath)" DestinationFolder="$(TargetDir)Fixtures" />
  </Target>
</Project>
