<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>PeakReplayLab.LocalCinemaSmoke</AssemblyName>
    <Version>0.0.1</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <PEAKGameRootDir Condition="'$(PEAKGameRootDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/PEAK/</PEAKGameRootDir>
  </PropertyGroup>
  <ItemGroup>
    <GameAssembly Include="$(PEAKGameRootDir)PEAK_Data/Managed/*.dll" Exclude="$(PEAKGameRootDir)PEAK_Data/Managed/Mono*.dll;$(PEAKGameRootDir)PEAK_Data/Managed/netstandard.dll;$(PEAKGameRootDir)PEAK_Data/Managed/System*.dll;$(PEAKGameRootDir)PEAK_Data/Managed/mscorlib.dll" />
    <Reference Include="@(GameAssembly)" Private="false" />
    <Reference Include="$(PEAKGameRootDir)BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(PEAKGameRootDir)BepInEx/core/0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
